# ============================================================
# ARENA 10 Backend — Variables d'environnement
# COPIER CE FICHIER EN .env ET REMPLIR LES VALEURS
# NE JAMAIS COMMITER .env DANS GIT !
# ============================================================

# ── Port du serveur ─────────────────────────────────────────
PORT=4000

# ── Clé secrète interne (générée aléatoirement, min 32 chars)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=REMPLACER_PAR_UNE_CLE_SECRETE_32_CHARS_MIN

# ── URL du frontend autorisé (CORS)
FRONTEND_URL=http://localhost:5173

# ── NewsAPI.org (actualités football en temps réel)
# Inscription gratuite sur: https://newsapi.org/register
# IMPORTANT: en mode dev uniquement (plan gratuit)
# Plan payant pour la production: https://newsapi.org/pricing
NEWS_API_KEY=VOTRE_CLE_NEWSAPI_ICI

# ── API-Football via RapidAPI (données matchs avancées — optionnel)
# Inscription sur: https://rapidapi.com/api-sports/api/api-football
# 100 requêtes/jour gratuit
RAPID_API_KEY=VOTRE_CLE_RAPIDAPI_ICI
RAPID_API_HOST=api-football-v1.p.rapidapi.com

# ── The Sports DB (gratuit, sans clé requise)
SPORTS_DB_BASE_URL=https://www.thesportsdb.com/api/v1/json/3

# ── Cache TTL (en secondes)
CACHE_TTL_NEWS=300
CACHE_TTL_MATCHES=120
CACHE_TTL_STANDINGS=600

# ── Environnement
NODE_ENV=development

# ── Logs
LOG_LEVEL=combined

